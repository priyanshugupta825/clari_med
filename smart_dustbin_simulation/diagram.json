      "left": 360,
      "attrs": {}
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "ir_sensor",
      "top": 180,
      "left": -60,
      "attrs": {}
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 120,
      "left": 420,
