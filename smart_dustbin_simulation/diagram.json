    [ "esp:D7", "led_red:A", "red", [ "v0" ] ],
    [ "led_red:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.2", "black", [ "v0" ] ],

    [ "esp:D8", "led_green:A", "green", [ "v0" ] ],
    [ "led_green:C", "r2:1", "black", [ "v0" ] ],
    [ "r2:2", "esp:GND.2", "black", [ "v0" ] ]
